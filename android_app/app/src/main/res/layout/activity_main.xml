<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="80dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <!-- App Icon Area -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/rhi_badge_background"
            android:gravity="center"
            android:text="RF"
            android:textColor="#3DDC84"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="RoadFlow AI"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="AI-Powered Road Health Monitoring"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="48dp" />

        <!-- Button 1: Login as Driver / Officer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Login as Driver / Officer"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="#3DDC84"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_myplaces"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Helper text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="For navigation and management dashboard"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <!-- Button 2: Report a Damage -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReportDamage"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Report a Damage"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_report_image"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="#FFA500"
            app:strokeColor="#FFA500"
            app:strokeWidth="2dp" />

        <!-- Helper text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Anonymous citizen reporting — no login required"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <!-- Button 3: Live Scanner (testing access) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLiveScanner"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Open Live Scanner"
            android:textAllCaps="false"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="#B3FFFFFF"
            app:rippleColor="#333333" />

        <!-- Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="v1.0 — Powered by YOLOv8"
            android:textColor="#4DFFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
