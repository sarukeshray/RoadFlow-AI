<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".LoginActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Role"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Firebase Auth coming soon.\nUse the demo buttons below."
        android:textColor="#B3FFFFFF"
        android:textSize="15sp" />

    <!-- Driver Navigation -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueDriver"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:text="Continue as Driver (Demo)"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="#FFA500"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_menu_directions"
        app:iconGravity="textStart"
        app:iconPadding="12dp" />

    <!-- Officer Dashboard -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueOfficer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Continue as Officer (Demo)"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="#3DDC84"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_menu_myplaces"
        app:iconGravity="textStart"
        app:iconPadding="12dp" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:onClick="onBackPressed"
        android:text="Go Back"
        android:textAllCaps="false"
        android:textColor="#B3FFFFFF"
        app:rippleColor="#333333" />

</LinearLayout>
