<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme (dark, no action bar) -->
    <style name="Theme.RoadFlowAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="colorPrimary">#3DDC84</item>
        <item name="colorPrimaryVariant">#2BBF6E</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#FFA500</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <!-- Full-screen theme for scanner activity -->
    <style name="Theme.RoadFlowAI.Scanner" parent="Theme.RoadFlowAI">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
