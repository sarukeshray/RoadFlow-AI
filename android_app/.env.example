# ============================================================
# RoadFlow-AI — ENVIRONMENT TEMPLATE
# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is gitignored and must never be committed.
#
#   cp android_app/.env.example android_app/.env
#
# These values are injected into BuildConfig at build time
# (see android_app/app/build.gradle). No google-services.json required.
# ============================================================

# --- Google Maps Platform (Maps SDK for Android, Directions, Places) ---
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# --- Firebase project configuration (from your Firebase console) ---
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_NUMBER=YOUR_FIREBASE_PROJECT_NUMBER
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_DB_URL=https://YOUR_PROJECT_ID-default-rtdb.REGION.firebasedatabase.app/
